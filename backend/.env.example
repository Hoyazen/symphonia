# Copier ce fichier en ".env" et adapter les valeurs si besoin

# Base de données PostgreSQL (doit correspondre à docker-compose.yml)
DB_URL=jdbc:postgresql://localhost:5432/symphonia
DB_USER=symphonia
DB_PASSWORD=symphonia

# Secret utilisé pour signer les tokens JWT (mettre une longue chaîne aléatoire)
JWT_SECRET=change-moi-avec-une-longue-chaine-secrete-aleatoire-en-production
JWT_EXPIRATION_MS=86400000

# Serveur mail (Mailpit en local, lancé via docker-compose)
MAIL_HOST=localhost
MAIL_PORT=1025

# Origine autorisée pour les requêtes CORS (le frontend)
CORS_ORIGIN=http://localhost:3000
