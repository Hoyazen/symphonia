# Paramétrage des paramètres pour accès BDD
spring.datasource.url=jdbc:postgresql://localhost:5432/symphonia

# Configuration concernant la gestion ds JWT
jwt.secret=change-moi-avec-une-longue-chaine-secrete-aleatoire-en-production
jwt-expiration=86400000

# Base de données PostgreSQL (doit correspondre à docker-compose.yml)
spring.datasource.url=jdbc:postgresql://localhost:5432/symphonia
spring.datasource.username=symphonia
spring.datasource.password=symphonia

# Configuration des emails (meilpit local)
spring.mail.host=localhost
spring.mail.port=1025
spring.mail.properties.mail.smtp.auth=false
spring.mail.properties.mail.smtp.starttls.enable=false

# Configuration des CORS (à adapter en fonction de l'environnement)
app.cors.origin=http://localhost:3000
